#!/bin/bash
set -u
LOG_FILE="${TRIM_PKGVAR}/clash-for-fnos.log"
PID_FILE="${TRIM_PKGVAR}/clash-for-fnos.pid"
HELPER_PID_FILE="${TRIM_PKGVAR}/clash-for-fnos-helper.pid"
SOCKET_LINK="${TRIM_APPDEST}/app.sock"
SOCKET_PATH="${TRIM_PKGVAR}/clash-for-fnos.sock"
PRIV_SOCKET_PATH="${TRIM_PKGVAR}/clash-for-fnos-priv.sock"
APP_DIR="${TRIM_APPDEST}/server"
APP_USER="${TRIM_USERNAME:-clash-for-fnos}"
APP_GROUP="${TRIM_GROUPNAME:-$APP_USER}"
STARTED_HELPER_PID=""
STARTED_WEB_PID=""

check_process() {
  case "${1:-}" in ''|*[!0-9]*) return 1 ;; esac
  [ "$1" -gt 1 ] && kill -0 "$1" 2>/dev/null || return 1
  # PID files survive reboot; never trust a reused PID belonging to another app.
  if [ -d /proc ] && [ -n "${2:-}" ]; then
    [ -r "/proc/$1/cmdline" ] || return 1
    tr '\0' '\n' < "/proc/$1/cmdline" | grep -Fx -- "$2" >/dev/null || return 1
  fi
}

# Only used for children launched by this invocation, never for persisted PIDs.
# Their cmdline may still be bash/runuser before exec. Check parentage instead.
owned_child_alive() {
  case "${1:-}" in ''|*[!0-9]*) return 1 ;; esac
  [ "$1" -gt 1 ] && kill -0 "$1" 2>/dev/null || return 1
  [ -r "/proc/$1/status" ] || return 1
  awk -v parent="$$" '
    /^PPid:/ { owned = ($2 == parent) }
    /^State:/ { alive = ($2 != "Z" && $2 != "X") }
    END { exit !(owned && alive) }
  ' "/proc/$1/status"
}

pid_from_file() {
  [ -f "$1" ] || return 1
  head -n 1 "$1" | tr -d '[:space:]'
}

status_app() {
  local pid helper
  pid="$(pid_from_file "$PID_FILE" 2>/dev/null || true)"
  helper="$(pid_from_file "$HELPER_PID_FILE" 2>/dev/null || true)"
  check_process "$pid" "$(go_web_binary)" && check_process "$helper" "$(go_helper_binary)" \
    && [ -S "$SOCKET_PATH" ] \
    && [ -L "$SOCKET_LINK" ] && [ -S "$PRIV_SOCKET_PATH" ]
}

go_helper_binary() {
  case "$(uname -m)" in
    x86_64|amd64) printf '%s\n' "${APP_DIR}/bin/clash-for-fnos-helper-x86_64" ;;
    aarch64|arm64) printf '%s\n' "${APP_DIR}/bin/clash-for-fnos-helper-arm64" ;;
    *) return 1 ;;
  esac
}

go_web_binary() {
  case "$(uname -m)" in
    x86_64|amd64) printf '%s\n' "${APP_DIR}/bin/clash-for-fnos-web-x86_64" ;;
    aarch64|arm64) printf '%s\n' "${APP_DIR}/bin/clash-for-fnos-web-arm64" ;;
    *) return 1 ;;
  esac
}

# Poll readiness for up to 30 seconds, but fail immediately if a child exits.
wait_ready() {
  local kind="$1" attempt helper pid
  for ((attempt=0; attempt<150; attempt++)); do
    helper="$(pid_from_file "$HELPER_PID_FILE" 2>/dev/null || true)"
    if ! owned_child_alive "$helper"; then
      echo "$(date '+%F %T') helper exited before readiness (pid=$helper)" >> "$LOG_FILE"
      return 1
    fi
    if [ "$kind" = helper ]; then
      if check_process "$helper" "$(go_helper_binary)" && [ -S "$PRIV_SOCKET_PATH" ]; then return 0; fi
    else
      pid="$(pid_from_file "$PID_FILE" 2>/dev/null || true)"
      if ! owned_child_alive "$pid"; then
        echo "$(date '+%F %T') web exited before readiness (pid=$pid)" >> "$LOG_FILE"
        return 1
      fi
      status_app && return 0
    fi
    sleep 0.2
  done
  echo "$(date '+%F %T') $kind readiness timed out after 30 seconds" >> "$LOG_FILE"
  return 1
}

start_app() {
  if status_app; then return 0; fi
  # Reconcile a partially started previous attempt before replacing PID files.
  stop_app
  mkdir -p "${TRIM_PKGVAR}" "${TRIM_PKGETC}"
  touch "$LOG_FILE" 2>/dev/null || true
  rm -f "$SOCKET_PATH" "$SOCKET_LINK" "$PRIV_SOCKET_PATH" "$PID_FILE" "$HELPER_PID_FILE"
  ln -s "$SOCKET_PATH" "$SOCKET_LINK"

  # Keep the web UI as the dedicated package user. Only the restricted helper stays root.
  chown -R "$APP_USER:$APP_GROUP" "${TRIM_PKGVAR}" "${TRIM_PKGETC}" 2>/dev/null || true

  # core-stage is written by the unprivileged web process, but the root helper
  # starts first and also needs to read/verify files from it. Pre-create it here
  # before starting the helper so it never becomes root:root on a fresh install.
  mkdir -p "${TRIM_PKGVAR}/core-stage"
  chown -R "$APP_USER:$APP_GROUP" "${TRIM_PKGVAR}/core-stage" 2>/dev/null || true
  chmod 700 "${TRIM_PKGVAR}/core-stage" 2>/dev/null || true

  # Persist fnOS native authorized-folder list so config changes can be picked up
  # by the package-user web process without granting it broad filesystem access.
  printf '%s' "${TRIM_DATA_ACCESSIBLE_PATHS:-}" > "${TRIM_PKGETC}/authorized-paths.txt"
  chown "$APP_USER:$APP_GROUP" "${TRIM_PKGETC}/authorized-paths.txt" 2>/dev/null || true
  chmod 600 "${TRIM_PKGETC}/authorized-paths.txt" 2>/dev/null || true

  # Manager-owned Core and its startup config stay root-owned. The web process
  # never writes these paths directly; it must go through the restricted helper.
  mkdir -p "${TRIM_PKGVAR}/managed-core" "${TRIM_PKGETC}/mihomo"
  chown -R root:root "${TRIM_PKGVAR}/managed-core" "${TRIM_PKGETC}/mihomo" 2>/dev/null || true
  chmod 750 "${TRIM_PKGVAR}/managed-core" "${TRIM_PKGETC}/mihomo" 2>/dev/null || true
  [ ! -f "${TRIM_PKGETC}/mihomo/config.yaml" ] || chmod 640 "${TRIM_PKGETC}/mihomo/config.yaml" 2>/dev/null || true

  # Seed bundled Mihomo GEO databases into the managed HomeDir on first use.
  # Existing files are preserved so user/online updates are never overwritten by restart.
  local bundled_geo_dir="${TRIM_APPDEST}/geodata" geo_name
  for geo_name in Country.mmdb geoip.dat geosite.dat; do
    if [ -f "${bundled_geo_dir}/${geo_name}" ] && [ ! -f "${TRIM_PKGETC}/mihomo/${geo_name}" ]; then
      cp -f "${bundled_geo_dir}/${geo_name}" "${TRIM_PKGETC}/mihomo/${geo_name}"
    fi
    [ ! -f "${TRIM_PKGETC}/mihomo/${geo_name}" ] || chown root:root "${TRIM_PKGETC}/mihomo/${geo_name}" 2>/dev/null || true
    [ ! -f "${TRIM_PKGETC}/mihomo/${geo_name}" ] || chmod 644 "${TRIM_PKGETC}/mihomo/${geo_name}" 2>/dev/null || true
  done

  cd "$APP_DIR" || exit 1
  local helper_binary
  helper_binary="$(go_helper_binary 2>/dev/null || true)"
  if [ -z "$helper_binary" ] || [ ! -x "$helper_binary" ]; then
    echo "Clash for fnos Go helper binary is missing for $(uname -m)" > "${TRIM_TEMP_LOGFILE:-/tmp/clash-for-fnos-error.log}"
    return 1
  fi

  echo "$(date '+%F %T') starting Clash for fnos Go privileged helper" >> "$LOG_FILE"
  HTTP_PROXY= HTTPS_PROXY= ALL_PROXY= NO_PROXY= http_proxy= https_proxy= all_proxy= no_proxy= \
    PRIV_SOCKET_PATH="$PRIV_SOCKET_PATH" TRIM_PKGETC="$TRIM_PKGETC" TRIM_PKGVAR="$TRIM_PKGVAR" \
    TRIM_APPDEST="$TRIM_APPDEST" TRIM_APPNAME="${TRIM_APPNAME:-clash-for-fnos}" \
    "$helper_binary" 9>&- >> "$LOG_FILE" 2>&1 &
  STARTED_HELPER_PID=$!
  echo "$STARTED_HELPER_PID" > "$HELPER_PID_FILE"

  if ! wait_ready helper; then
    echo "Clash for fnos privileged helper failed to start; see $LOG_FILE" > "${TRIM_TEMP_LOGFILE:-/tmp/clash-for-fnos-error.log}"
    stop_app
    return 1
  fi
  chown "$APP_USER:$APP_GROUP" "$PRIV_SOCKET_PATH" 2>/dev/null || true
  chmod 660 "$PRIV_SOCKET_PATH" 2>/dev/null || true
  touch "$LOG_FILE"
  chown "$APP_USER:$APP_GROUP" "$LOG_FILE" 2>/dev/null || true
  chmod 640 "$LOG_FILE" 2>/dev/null || true

  local web_binary
  web_binary="$(go_web_binary 2>/dev/null || true)"
  if [ -z "$web_binary" ] || [ ! -x "$web_binary" ]; then
    echo "Clash for fnos Go web binary is missing for $(uname -m)" > "${TRIM_TEMP_LOGFILE:-/tmp/clash-for-fnos-error.log}"
    stop_app
    return 1
  fi

  echo "$(date '+%F %T') starting Go web gateway as $APP_USER" >> "$LOG_FILE"
  runuser -u "$APP_USER" -- env \
    HTTP_PROXY= HTTPS_PROXY= ALL_PROXY= NO_PROXY= \
    http_proxy= https_proxy= all_proxy= no_proxy= \
    GATEWAY_PREFIX="/app/clash-for-fnos" \
    SOCKET_PATH="$SOCKET_PATH" \
    PUBLIC_DIR="${APP_DIR}/public" \
    TRIM_PKGETC="$TRIM_PKGETC" \
    TRIM_PKGVAR="$TRIM_PKGVAR" \
    TRIM_DATA_ACCESSIBLE_PATHS="${TRIM_DATA_ACCESSIBLE_PATHS:-}" \
    PRIV_SOCKET_PATH="$PRIV_SOCKET_PATH" \
    "$web_binary" 9>&- >> "$LOG_FILE" 2>&1 &
  STARTED_WEB_PID=$!
  echo "$STARTED_WEB_PID" > "$PID_FILE"

  if ! wait_ready app; then
    echo "Clash for fnos failed to start" > "${TRIM_TEMP_LOGFILE:-/tmp/clash-for-fnos-error.log}"
    stop_app
    return 1
  fi
}

stop_target_alive() {
  if { [ "$1" = "$STARTED_HELPER_PID" ] || [ "$1" = "$STARTED_WEB_PID" ]; } && owned_child_alive "$1"; then
    return 0
  fi
  check_process "$1" "$2"
}

stop_one() {
  local file="$1" pid expected
  if [ "$file" = "$HELPER_PID_FILE" ]; then expected="$(go_helper_binary)"; else expected="$(go_web_binary)"; fi
  pid="$(pid_from_file "$file" 2>/dev/null || true)"
  if ! stop_target_alive "$pid" "$expected"; then rm -f "$file"; return 0; fi
  kill -TERM "$pid" 2>/dev/null || true
  local attempt
  for ((attempt=0; attempt<40; attempt++)); do
    stop_target_alive "$pid" "$expected" || break
    sleep 0.5
  done
  stop_target_alive "$pid" "$expected" && kill -KILL "$pid" 2>/dev/null || true
  rm -f "$file"
}

stop_app() {
  stop_one "$PID_FILE"
  stop_one "$HELPER_PID_FILE"
  rm -f "$SOCKET_PATH" "$SOCKET_LINK" "$PRIV_SOCKET_PATH"
}

if [ "${1:-}" = start ] || [ "${1:-}" = stop ]; then
  mkdir -p "$TRIM_PKGVAR" || exit 1
  exec 9>"$TRIM_PKGVAR/lifecycle.lock"
  flock -w 90 9 || exit 1
fi

case "${1:-}" in
  start) start_app ;;
  stop) stop_app ;;
  status) status_app && exit 0 || exit 3 ;;
  *) exit 1 ;;
esac
